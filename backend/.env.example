# AquaVision Backend Configuration Example
# Copy this file to .env and adjust variables as needed.

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Storage & Model Weights Directories
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
WEIGHTS_PATH=weights/model.pth

# CORS Security (Comma-separated allowed origins or * for development)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Device Configuration ('auto', 'cuda', 'cpu')
DEVICE=auto
