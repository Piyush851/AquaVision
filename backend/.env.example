# AquaVision Backend Configuration Example
# Copy this file to .env and adjust variables as needed.

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Storage & Model Weights Directories
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
WEIGHTS_PATH=weights/model.pth

# CORS Security (Comma-separated allowed origins or * for development)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Device Configuration ('auto', 'cuda', 'cpu')
DEVICE=auto

# Database Configuration (PostgreSQL Docker container or local instance)
# Falls back to local sqlite:///./aquavision.db if PostgreSQL is unavailable
DATABASE_URL=postgresql://aquavision_user:aquavision_secure_password_2026@localhost:5432/aquavision

# Security & Session Settings
JWT_SECRET=aquavision_jwt_secret_key_2026_super_secure_marine_vision
JWT_ALGORITHM=HS256
SESSION_EXPIRE_HOURS=24
GUEST_MAX_ENHANCEMENTS=5
